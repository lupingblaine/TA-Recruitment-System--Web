<%@ page pageEncoding="UTF-8" %><%@ include file="/common/auth-check.jsp" %><jsp:include page="/common/layout-top.jsp"/>
<div class="max-w-4xl mx-auto space-y-5"><h1 class="text-3xl font-bold">TA Application Profile</h1><p>Complete the sponsor application fields. Submitted applications retain their own historical snapshots. Skills are selected from options configured by course staff.</p><p id="qualificationMessage" role="status" aria-live="polite"></p>
<form id="qualificationForm" class="card p-5 space-y-4"><fieldset id="qualificationFields" class="space-y-4">
<div class="grid sm:grid-cols-2 gap-4"><label>First name<input name="firstName" class="input" required maxlength="100"></label><label>Last name<input name="lastName" class="input" required maxlength="100"></label></div>
<label class="block">UCI email<input name="uciEmail" type="email" class="input" required maxlength="254"></label><label class="block">UCI student ID<input name="uciStudentId" class="input" required pattern="[0-9]{8}" maxlength="8" inputmode="numeric"></label>
<label class="block">Student level<select name="studentLevel" class="input" required><option value="undergraduate">Undergraduate</option><option value="masters">Master's</option><option value="phd">PhD</option></select></label><label class="block">Academic program<input name="program" class="input" required maxlength="200"></label>
<label class="block">Year you started your graduate program (graduate students)<input name="graduateStartYear" type="number" min="1900" max="<%= java.time.Year.now().getValue() %>" class="input"></label><label class="block">Faculty / PI (enter N/A if not applicable)<input name="facultyPI" class="input" required maxlength="200"></label>
<label class="block">Total number of quarters previously served as a TA at UCI (not including summer)<input name="taQuarters" type="number" min="0" max="100" step="1" required value="0" class="input"></label>
<label class="block">Have you advanced to candidacy?<select name="advancedToCandidacy" class="input" required><option value="">Choose</option><option value="yes">Yes</option><option value="no">No</option><option value="not_applicable">N/A</option></select></label>
<label class="block">Did you complete the TA Training?<select name="trainingStatus" class="input" required><option value="">Choose</option><option value="completed">Yes</option><option value="not_started">No</option><option value="in_progress">In progress</option><option value="not_applicable">N/A</option></select></label>
<label class="block">Did you complete the Online Sexual Harassment Training?<select name="sexualHarassmentTrainingCompleted" class="input" required><option value="">Choose</option><option value="true">Yes</option><option value="false">No</option></select></label>
<label class="block">Additional on-campus employment during this quarter (e.g. Housing Assistant; enter None if none)<textarea name="additionalEmployment" class="input" maxlength="1000" required></textarea></label>
<label class="block">Do you have a documented accommodation filed with the UCI Disability Services Center that needs consideration for ASE assignments?<select name="documentedAccommodation" class="input" required><option value="">Choose</option><option value="true">Yes</option><option value="false">No</option></select></label><label class="block">Accommodation arrangement notes (optional; describe assignment needs only)<textarea name="accommodationNotes" class="input" maxlength="2000"></textarea></label>
<fieldset><legend class="font-semibold">Skills &amp; experience</legend><p class="text-sm">Choose skills you have. Course staff provide these options.</p><div id="qualificationSkills" class="grid sm:grid-cols-3 gap-2 my-3"></div></fieldset><label class="block">Additional teaching / experience details<textarea name="teachingExperience" class="input" maxlength="4000"></textarea></label><label class="block">Research experience<textarea name="researchExperience" class="input" maxlength="4000"></textarea></label>
<fieldset><legend class="font-semibold">Courses of interest</legend><div id="qualificationInterests" class="grid sm:grid-cols-2 gap-2 my-3"></div></fieldset>
<label class="block">Scheduling conflicts / notes<textarea name="schedulingConflicts" class="input" maxlength="4000"></textarea></label><p class="text-sm">Also complete <a class="underline" href="<%= request.getContextPath() %>/applicant/availability.jsp">Weekly Availability</a> for each cycle. Matching uses the submitted weekly schedule; these notes provide additional context.</p><label class="block">Additional comments<textarea name="additionalComments" class="input" maxlength="4000"></textarea></label>
<label class="flex gap-2"><input name="ackSchedule" type="checkbox" required>By checking this box, I acknowledge that I have consulted the Schedule of Classes to minimize scheduling conflicts with my potential ASE assignment.</label>
<label class="flex gap-2"><input name="ackEnrollment" type="checkbox" required>By checking this box, I acknowledge that I need to enroll as a full time student (at least 12 units) and pay any outstanding balance on my Zot account prior to the fee payment deadline before my tuition remission can be applied.</label>
<label class="flex gap-2"><input name="acknowledged" type="checkbox" required>I confirm that the information I submit is accurate to the best of my knowledge.</label><button class="btn btn-primary">Save application profile</button></fieldset></form></div>
<jsp:include page="/common/layout-bottom.jsp"/><script src="<%= request.getContextPath() %>/static/js/application-profile.js"></script>
