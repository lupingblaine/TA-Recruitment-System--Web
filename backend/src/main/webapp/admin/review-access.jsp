<%@ page pageEncoding="UTF-8" %><%@ include file="/common/auth-check.jsp" %><jsp:include page="/common/layout-top.jsp" />
<div class="max-w-3xl mx-auto space-y-5"><h1 class="text-3xl font-bold">Review Access</h1><p>Create staff accounts in Users, then assign review permissions and course scope here. Teachers retain their current course ownership scope. Advanced review role Viewer defaults are read-only; final decision authority requires an explicit approval grant.</p><label>Staff account<select id="accessUser" class="input"></select></label><p id="accessMessage" role="status"></p><form id="accessForm" class="card p-5 space-y-4"><fieldset id="accessPermissions"><legend class="font-bold">Permissions</legend></fieldset><fieldset id="accessCourses"><legend class="font-bold">Permitted courses (advanced review roles: Reviewer / Decision-maker / Viewer)</legend></fieldset><button class="btn btn-primary">Save access</button></form></div>
<jsp:include page="/common/layout-bottom.jsp" /><script>
(async()=>{const select=document.getElementById('accessUser'),form=document.getElementById('accessForm'),message=document.getElementById('accessMessage');let data;
function checks(parent,items,selected,name){parent.querySelectorAll('label').forEach(n=>n.remove());for(const [id,text]of items){const label=document.createElement('label');label.className='flex gap-2';const input=document.createElement('input');input.type='checkbox';input.name=name;input.value=id;input.checked=selected.includes(id);label.append(input,document.createTextNode(text));parent.appendChild(label);}}
function show(){const u=data.users.find(u=>u.id===select.value);if(!u)return;checks(document.getElementById('accessPermissions'),[['review.read','View applications'],['review.note','Internal notes and flags'],['review.recommend','Recommend / alternate'],['review.approve','Approve / not select']],u.permissions,'permissions');checks(document.getElementById('accessCourses'),data.modules.map(m=>[m.id,m.code+' · '+m.name]),u.courseIds,'courseIds');}
try{data=await request('/admin/review-access/');data.users.filter(u=>u.role!=='admin').forEach(u=>select.add(new Option(u.name+' · '+displayRole(u.role),u.id)));show();}catch(e){message.textContent=e.message;}select.onchange=show;
form.onsubmit=async e=>{e.preventDefault();const button=form.querySelector('button');button.disabled=true;select.disabled=true;const entries=new FormData(form);try{data=await request('/admin/review-access/'+encodeURIComponent(select.value),{method:'PUT',body:JSON.stringify({permissions:entries.getAll('permissions'),courseIds:entries.getAll('courseIds')})});message.textContent='Permissions saved. Changes apply to subsequent review requests.';show();}catch(e){message.textContent=e.message;}finally{button.disabled=false;select.disabled=false;}};})();
</script>
