<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>TA&amp;MO Backend</display-name>

    <listener>
        <listener-class>com.tamo.listener.AppContextListener</listener-class>
    </listener>

    <!-- Filters -->
    <filter>
        <filter-name>CharacterEncodingFilter</filter-name>
        <filter-class>com.tamo.filter.CharacterEncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>CorsFilter</filter-name>
        <filter-class>com.tamo.filter.CorsFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CorsFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>DatabaseTransactionFilter</filter-name>
        <filter-class>com.tamo.filter.DatabaseTransactionFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>DatabaseTransactionFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.tamo.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/api/applicant/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/api/organiser/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/api/admin/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/api/messages/*</url-pattern>
    </filter-mapping>

    <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>/applicant/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>/organiser/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>/admin/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>/review/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>/common/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>/api/csv/*</url-pattern></filter-mapping>

    <servlet><servlet-name>SectionAssignmentServlet</servlet-name><servlet-class>com.tamo.servlet.SectionAssignmentServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>SectionAssignmentServlet</servlet-name><url-pattern>/api/admin/assignments/*</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>SectionAssignmentServlet</servlet-name><url-pattern>/api/organiser/assignments/*</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>SectionAssignmentServlet</servlet-name><url-pattern>/api/applicant/assignments/*</url-pattern></servlet-mapping>
<servlet><servlet-name>CriteriaServlet</servlet-name><servlet-class>com.tamo.servlet.CriteriaServlet</servlet-class></servlet>
<servlet-mapping><servlet-name>CriteriaServlet</servlet-name><url-pattern>/api/admin/criteria/*</url-pattern></servlet-mapping>
<servlet-mapping><servlet-name>CriteriaServlet</servlet-name><url-pattern>/api/organiser/criteria/*</url-pattern></servlet-mapping>
<servlet><servlet-name>ReviewServlet</servlet-name><servlet-class>com.tamo.servlet.ReviewServlet</servlet-class></servlet>
<servlet-mapping><servlet-name>ReviewServlet</servlet-name><url-pattern>/api/review/*</url-pattern></servlet-mapping>
<servlet-mapping><servlet-name>ReviewServlet</servlet-name><url-pattern>/api/admin/review-access/*</url-pattern></servlet-mapping>
<filter><filter-name>ProtectedUploadFilter</filter-name><filter-class>com.tamo.filter.ProtectedUploadFilter</filter-class></filter><filter-mapping><filter-name>ProtectedUploadFilter</filter-name><url-pattern>/static/uploads/*</url-pattern></filter-mapping>
<servlet><servlet-name>DocumentServlet</servlet-name><servlet-class>com.tamo.servlet.DocumentServlet</servlet-class></servlet><servlet-mapping><servlet-name>DocumentServlet</servlet-name><url-pattern>/api/documents/*</url-pattern></servlet-mapping>
    <!-- Servlets -->
    <servlet>
        <servlet-name>CourseSectionServlet</servlet-name>
        <servlet-class>com.tamo.servlet.CourseSectionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CourseSectionServlet</servlet-name>
        <url-pattern>/api/admin/course-sections/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CourseSectionServlet</servlet-name>
        <url-pattern>/api/organiser/course-sections/*</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>ApplicationPeriodServlet</servlet-name>
        <servlet-class>com.tamo.servlet.ApplicationPeriodServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApplicationPeriodServlet</servlet-name>
        <url-pattern>/api/admin/application-periods/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ApplicationPeriodServlet</servlet-name>
        <url-pattern>/api/organiser/application-periods/*</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.tamo.servlet.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/api/auth/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApplicantServlet</servlet-name>
        <servlet-class>com.tamo.servlet.ApplicantServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApplicantServlet</servlet-name>
        <url-pattern>/api/applicant/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>OrganiserServlet</servlet-name>
        <servlet-class>com.tamo.servlet.OrganiserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OrganiserServlet</servlet-name>
        <url-pattern>/api/organiser/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>com.tamo.servlet.AdminServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/api/admin/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MessageServlet</servlet-name>
        <servlet-class>com.tamo.servlet.MessageServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MessageServlet</servlet-name>
        <url-pattern>/api/messages/*</url-pattern>
    </servlet-mapping>

<servlet><servlet-name>SponsorCsvServlet</servlet-name><servlet-class>com.tamo.servlet.SponsorCsvServlet</servlet-class></servlet><servlet-mapping><servlet-name>SponsorCsvServlet</servlet-name><url-pattern>/api/csv/*</url-pattern></servlet-mapping>
</web-app>
