<%@ page pageEncoding="UTF-8" %><%@ include file="/common/auth-check.jsp" %><jsp:include page="/common/layout-top.jsp" />
<div class="max-w-6xl mx-auto space-y-5"><h1 class="text-3xl font-bold">Review Workspace</h1><p>Review submitted information and explanations. Recommendations and final decisions are recorded separately. Your course access and actions are granted by an administrator.</p><form id="reviewFilters" class="card p-4 flex flex-wrap gap-3">
<label>Cycle<select name="periodId" id="reviewPeriod" class="input"></select></label><label>Course<select name="moduleId" id="reviewCourse" class="input"><option value="">All permitted courses</option></select></label><label>Applicant name<input name="search" class="input"></label><label>Student level<select name="level" class="input"><option value="">All</option><option value="undergraduate">Undergraduate</option><option value="masters">Master’s</option><option value="phd">PhD</option></select></label><label>Skill<input name="skill" class="input"></label><label>Interest<input name="interest" class="input"></label>
<label>Teaching experience<select name="experience" class="input"><option value="">All</option><option value="yes">Reported</option><option value="no">None reported</option></select></label><label>Qualification match<select name="match" class="input"><option value="">All</option><option value="meets_required">Meets required</option><option value="missing_required">Missing required</option><option value="needs_confirmation">Needs confirmation</option></select></label><label>Selection<select name="selectionStatus" class="input"><option value="">All</option><option value="selected">Selected / approved</option><option value="recommend">Recommended</option><option value="alternate">Alternate</option><option value="flag">Flagged</option><option value="not_selected">Not selected</option><option value="under_consideration">Under consideration</option></select></label><label>Sort<select name="sort" class="input"><option value="newest">Newest</option><option value="name">Name</option><option value="score">Qualification score</option></select></label><button class="btn btn-primary">Apply filters</button></form><p id="reviewMessage" role="status"></p><div id="reviewRows" class="space-y-4"></div></div>
<jsp:include page="/common/layout-bottom.jsp" /><script src="<%= request.getContextPath() %>/static/js/qualification-view.js"></script><script src="<%= request.getContextPath() %>/static/js/criteria-view.js"></script><script src="<%= request.getContextPath() %>/static/js/section-matching.js"></script><script src="<%= request.getContextPath() %>/static/js/review.js"></script>
